---
interface Props {
  title: string;
  description: string;
  image?: string;
  links?: {
    label: string;
    href: string;
  }[];
}

const { title, description, image, links = [] } = Astro.props;
const href = links[0]?.href;
---
<div class="project-card">
  <div class="thumbnail">
    {image ? (
      <img src={image} alt={title} />
    ) : (
      <div class="placeholder" />
    )}
  </div>
  <div class="content">
    <h3>
      <span class="prefix">$ </span><a class="title-link" href={href} target={href?.startsWith('http') ? '_blank' : undefined} rel={href?.startsWith('http') ? 'noopener noreferrer' : undefined}>{title}</a>
    </h3>
    <p>{description}</p>
    {links.length > 0 && (
      <div class="links">
        {links.map((link, index) => (
          <>
            {index > 0 && <span class="separator">/</span>}
            <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}>{link.label}</a>
          </>
        ))}
      </div>
    )}
  </div>
</div>

<style>
  .project-card {
    display: flex;
    flex-direction: row;
    gap: 1.5rem;
    padding: 2rem 0;
    align-items: flex-start;
  }

  .thumbnail {
    flex-shrink: 0;
    width: 96px;
    height: 96px;
  }

  .thumbnail img {
    width: 96px;
    height: 96px;
    border-radius: 18px;
    object-fit: cover;
    display: block;
    border: 1px solid #333;
  }

  .placeholder {
    width: 96px;
    height: 96px;
    border-radius: 18px;
    background: var(--color-border);
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
  }

  .title-link {
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .title-link:hover {
    color: var(--color-accent);
  }

  .prefix {
    color: var(--color-text-muted);
    user-select: none;
  }

  p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .links {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    font-family: var(--font-mono);
  }

  a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .separator {
    color: var(--color-text-muted);
    margin: 0 0.5rem;
  }

  @media (max-width: 520px) {
    .project-card {
      flex-direction: row;
      gap: 1rem;
      padding: 1.25rem 0;
    }

    .thumbnail {
      width: 56px;
      height: 56px;
    }

    .thumbnail img {
      width: 56px;
      height: 56px;
      border-radius: 12px;
    }

    .placeholder {
      width: 56px;
      height: 56px;
      border-radius: 12px;
    }

    h3 {
      font-size: 1rem;
    }

    .prefix {
      display: none;
    }

    p {
      font-size: 0.8rem;
      line-height: 1.4;
    }

    .links {
      font-size: 0.8rem;
    }
  }
</style>
